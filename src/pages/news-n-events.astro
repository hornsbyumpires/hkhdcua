---
// Data import
import news from "../data/news-page.json";

import MainLayout from "../layouts/MainLayout.astro";
import SecondryHero from "../components/SecondryHero.astro";
import News from "../components/News.astro";
---

<MainLayout
	title="Welcome to Hornsby Ku-ring-gai & Hills District Cricket Umpires Association."
>
	<SecondryHero
		title="News & Events of HKHDCUA"
		subtitle="Our News and Events"
		description="The Association as formed in 1989 and incorporated in 2008 to administer, promote and manage the development of cricket umpires within the Hornsby Ku- Ring- Gai & Hills District Cricket Association."
		image="./src/asset/images/news-and-events.jpg"
		link=""
		linkText=""
	/>
	<News
		title=""
		subtitle=""
		news={news}
	/>
</MainLayout>
