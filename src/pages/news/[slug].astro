---
import MainLayout from "../../layouts/MainLayout.astro";
import { Picture } from "@astrojs/image/components";
import { getNews, formatDate, ratioOf, type NewsEntry } from "../../lib/news";

export async function getStaticPaths() {
	const entries = await getNews();
	return entries
		.filter((entry) => !entry.data.link) // legacy pages have their own .astro file
		.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
	entry: NewsEntry;
}

const { entry } = Astro.props;
const { title, date, image, alt, gallery, description } = entry.data;
const { Content } = await entry.render();

// Natural shapes, so photos are never cropped or stretched on the article page
const coverRatio = await ratioOf(image);
const galleryItems = await Promise.all(
	gallery.map(async (src) => ({ src, ratio: await ratioOf(src) }))
);
---

<MainLayout title={`${title} | Hornsby Ku-ring-gai & Hills District Cricket Umpires Association`}>
	<article class="border-t-2 px-4 py-16 mx-auto max-w-3xl md:px-8 lg:py-20">
		<p class="mb-2 text-xs font-semibold text-gray-600 uppercase">
			<time datetime={date.toISOString()}>{formatDate(date)}</time>
		</p>
		<h1 class="mb-8 font-sans text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl sm:leading-tight">
			{title}
		</h1>

		<div class="mb-10 overflow-hidden rounded shadow-lg">
			<Picture
				src={image}
				alt={alt || description}
				widths={[400, 800, 1200]}
				sizes="(max-width: 768px) 100vw, 768px"
				aspectRatio={coverRatio}
				class:list={"w-full h-auto"}
			/>
		</div>

		<div class="news-body text-lg leading-relaxed text-gray-700">
			<Content />
		</div>

		{
			galleryItems.length > 0 && (
				<div class="mt-12 gap-4 columns-2 sm:columns-3">
					{galleryItems.map(({ src, ratio }) => (
						<div class="mb-4 overflow-hidden rounded shadow break-inside-avoid">
							<Picture
								src={src}
								alt=""
								widths={[300, 600]}
								sizes="(max-width: 640px) 50vw, 250px"
								aspectRatio={ratio}
								class:list={"w-full h-auto"}
							/>
						</div>
					))}
				</div>
			)
		}
	</article>
</MainLayout>

<style>
	.news-body :global(p) { margin-bottom: 1.25em; }
	.news-body :global(h2) { font-size: 1.5rem; font-weight: 700; margin: 2em 0 0.75em; color: #111827; }
	.news-body :global(h3) { font-size: 1.25rem; font-weight: 700; margin: 1.5em 0 0.5em; color: #111827; }
	.news-body :global(ul) { list-style: disc; padding-left: 1.5rem; margin-bottom: 1.25em; }
	.news-body :global(ol) { list-style: decimal; padding-left: 1.5rem; margin-bottom: 1.25em; }
	.news-body :global(a) { color: #1d4ed8; text-decoration: underline; }
</style>