import BodyCopy from "../../components/BodyCopy.astro";
---

<MainLayout
	title="Welcome to Hornsby Ku-ring-gai & Hills District Cricket Umpires Association."
>
	<SecondryHero
		title="The Asquith Club"
		subtitle=""
		description="Our long-term sponsors, The Asquith Bowling and Recreation Club, have recently been renamed THE ASQUITH CLUB, and we express our thanks for their support over many years."
		image="./src/asset/images/tsbc.jpg"
		link=""
		linkText=""
	/>
	<BodyCopy
		title="About The Asquith Club"
		bodyCopy="<p class='text-base text-gray-700 mb-2'>Our long-term sponsors, The Asquith Bowling and Recreation Club, have recently been renamed THE ASQUITH CLUB, and we express our thanks for their support over many years.</p><p class='text-base text-gray-700 mb-2'>“The Bowlo”, as we have called it so often, has played host to our Committee Meetings, our Christmas Functions, the Training Programs for the Cricket Captains, managers and players and our AGM’s and Presentation Night Dinners with great cooperation and commitment.</p><p class='text-base text-gray-700 mb-2'>THE ASQUITH CLUB has recently repositioned itself as a broad-based community meeting place, whilst still maintaining its primary responsibility to the lawn bowlers, the traditional base of the club.</p><p class='text-base text-gray-700 mb-2'>The club offers an excellent opportunity for lunch or dinner, a well-stocked bar and very friendly committed service from its experienced staff.</p><p class='text-base text-gray-700 mb-2'>We, as umpires, often gather at the club at the conclusion of play to further develop our friendship over a well-deserved drink on a hot summer afternoon, with some staying a little longer to sample the menu from THE LODGE KITCHEN.</p><p class='text-base text-gray-700 mb-2'>Our home away from home, we enjoy the hospitality and support of THE ASQUITH CLUB and commend it to you as a very welcoming smaller venue in our community.</p><p class='text-base text-gray-700 mb-2'>You can be assured that you will be welcome at our sponsors venue…. click through to see the full program of activities and services offered throughout the week.</p><p class='text-base text-gray-700 mb-2'>Everything you wish for at your community club.</p></br>"
		link="https://www.asquithclub.au"
		linkText="The Asquith Club"
	/>
</MainLayout>
