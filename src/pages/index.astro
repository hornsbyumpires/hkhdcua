---
// Data import
import news from "../data/news.json";

import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Join from "../components/Join.astro";
import News from "../components/News.astro";
import Sponsors from "../components/Sponsors.astro";
---

<MainLayout
	title="Welcome to Hornsby Ku-ring-gai & Hills District Cricket Umpires Association."
>
	<Hero
		href="/join-with-us"
		title="Hornsby Ku-ring-gai & Hills District Cricket Umpires Association"
		subtitle="WELCOME TO"
		ctaText="Join with us"
	/>
	<About
		title="Who we are & what we do"
		subtitle="ABOUT US"
		body="The Association was formed in 1989 and incorporated in 2008 to administer, promote and manage the development of cricket umpires within the Hornsby Ku- Ring- Gai & Hills District Cricket Association. We provide umpires for the Senior, Junior (finals) and Representative Competitions as our primary responsibility. Training courses for Captains, players and managers are offered in addition to continuing education seminars for our umpires."
	/>
	<News
		title="Our upcoming news & events"
		subtitle="NEWS & EVENTS"
		news={news}
	/>
	<Sponsors
		title="Our valued sponsors"
		subtitle="OUR SPONSORS"
		body="Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque rem aperiam, eaque ipsa quae."
		,
		sponsorPrimary={{
			title: "The Asquith Club",
			body: "We have 3 excellent bowling greens, and offer a range of services and facilities including TAB, Sky Channel, Fox Sports, Keno plus much more. Please take the time to explore our web site for more information on our club.",
			image: "./src/asset/images/asquith-club.png",
			link: "https://asquithclub.au/",
		}}
		sponsorSecondry={{
			title: "Chadwick Real Estate",
			body: "With close to a decade’s worth of experience, combined with helping over 320 property seekers and $330 million in property transactions, Ray Talati is a sought after Upper North Shore property specialist.",
			image: "./src/asset/images/chadwickNewLogo.png",
			link: "https://chadwickrealestate.com.au/"
		}}
		sponsorTertiary={{
			title: "Ekim Brewing",
			body: "We are a small, locally owned craft brewery based in Mt Kuring-Gai, NSW. Raised in the area and with a combined 25 years of experience in the brewing industry, we are avid community members and supporters of local sports clubs, charity events, fire brigade, and fellow beer connoisseurs.",
			image: "./src/asset/images/ekim-brewing-logo.jpg",
			link: "https://ekimbrewing.com.au/"
		}}
	/>
	<Join
		title="Join us at the HKHDCUA"
		subtitle="JOIN US"
		body="We welcome new members to our association, be they ex-players, existing umpires who have moved into our area or close by, and provide, if required, further education, mentoring and inclusion to our team."
		href="/join-with-us"
		ctaText="Join with us"
		imageSrc="./src/asset/images/join-with-us.png"
	/>
</MainLayout>
