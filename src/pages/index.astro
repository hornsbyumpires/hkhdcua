---
// Data import
import news from "../data/news-home.json";

import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Join from "../components/Join.astro";
import News from "../components/News.astro";
import Sponsors from "../components/Sponsors.astro";
import Awards from "../components/Awards.astro";
---

<MainLayout
	title="Welcome to Hornsby Ku-ring-gai & Hills District Cricket Umpires Association."
>
	<Hero
		href="/join-with-us"
		title="Hornsby Ku-ring-gai & Hills District Cricket Umpires Association"
		subtitle="WELCOME TO"
		ctaText="Join with us"
	/>
	<Sponsors
		title="Our valued sponsors"
		subtitle="OUR SPONSORS"
		body=""
		sponsorPrimary={{
			title: "The Asquith Club",
			body: " Our long-term sponsors, The Asquith Bowling and Recreation Club, have recently been renamed THE ASQUITH CLUB, and we express our thanks for their support over many years.",
			image: "./src/asset/images/asquith-club.png",
			link: "sponsors/the-asquith-club",
		}}
		sponsorSecondry={{
			title: "Stone Real Estate",
			body: "A proud local and passionate cricketer, Ray Talati has been involved in the Cricket Association for 13 years and is now giving back as a sponsor. With over a decade of experience and more than $500 million in property transactions, Ray is Co-Principal at Stone Real Estate Wahroonga/Turramurra. Recognised as one of the area’s top-performing agents, he’s also Turramurra’s most recommended agent on realestate.com.au (2020–2024). Ray continues his commitment to supporting the community both on and off the field.",
			image: "./src/asset/images/stone_logo.png",
			link: "sponsors/chadwick-real-estate",
		}}
		sponsorTertiary={{
			title: "Ekim Brewing",
			body: "We are a small, locally owned craft brewery based in Mt Kuring-Gai, NSW. Raised in the area and with a combined 25 years of experience in the brewing industry, we are avid community members and supporters of local sports clubs, charity events, fire brigade, and fellow beer connoisseurs.",
			image: "./src/asset/images/ekim-brewing-logo.jpg",
			link: "sponsors/ekim-brewing",
		}}
	/>
	<News
		title="Our upcoming news & events"
		subtitle="NEWS & EVENTS"
		news={news}
	/>
	<About
		title="Who we are & what we do"
		subtitle="ABOUT US"
		body="The Association was formed in 1989 and incorporated in 2008 to administer, promote and manage the development of cricket umpires within the Hornsby Ku- Ring- Gai & Hills District Cricket Association. We provide umpires for the Senior, Junior (finals) and Representative Competitions as our primary responsibility. Training courses for Captains, players and managers are offered in addition to continuing education seminars for our umpires. For more information please email: <a class='text-blue-700' href='hornsbyumpires@outlook.com'>hornsbyumpires@outlook.com</a>"
		image="./src/asset/images/about-us-home.jpg"
	/>
	<Awards
		title="Awards & Recognition"
		subtitle="Awards"
		body="The Alex Terry Umpire of the Year Award, the Barry McDonald Umpire Service Award, and, since 2015/16, the President's Award were established by our association in 2012/2013 to acknowledge the exceptional performance of our members both on and off the field."
		award1="<p>The Alex Terry Umpire of the year for season 24/25: <span class='font-bold'>Steve Williams.</span><p>"
		award2="<p>The Barry McDonald Umpire Service Award for season 24/25: <span class='font-bold'>Ian Lewis &amp; Simon Moore</span></p>"
		award3="<p>The President's Award for season 24/25: <span class='font-bold'>Steve Williams.</span></p>"
		image="./src/asset/images/awards.jpg"
		href="/awards"
		ctaText="Learn more"
	/>
	<Join
		title="Join us at the HKHDCUA"
		subtitle="JOIN US"
		body="We welcome new members to our association, be they ex-players, existing umpires who have moved into our area or close by, and provide, if required, further education, mentoring and inclusion to our team."
		href="/join-with-us"
		ctaText="Join with us"
		imageSrc="./src/asset/images/join-with-us.jpg"
	/>
</MainLayout>
