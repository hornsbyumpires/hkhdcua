---
import MainLayout from "../layouts/MainLayout.astro";
import SecondryHero from "../components/SecondryHero.astro";
import ResourceLinks from "../components/ResourceLinks.astro";

// Data import
import resorceLinks from "../data/resourceLinks.json";
---

<MainLayout
	title="Welcome to Hornsby Ku-ring-gai & Hills District Cricket Umpires Association."
>
	<SecondryHero
		title="Resources of HKHDCUA"
		subtitle="Our Resources"
		description="The Association as formed in 1989 and incorporated in 2008 to administer, promote and manage the development of cricket umpires within the Hornsby Ku- Ring- Gai & Hills District Cricket Association."
		image="./src/asset/images/resources.jpg"
		link=""
		linkText=""
	/>
	<ResourceLinks title="Resources for reading" resorces={resorceLinks} />
</MainLayout>
