---
import MainLayout from "../layouts/MainLayout.astro";
import SecondryHero from "../components/SecondryHero.astro";
import FactCard from "../components/FactCard.astro";
import OfficeBearers from "../components/OfficeBearers.astro";

// Data import
import bearers from "../data/officeBearers.json";
---

<MainLayout
	title="Welcome to Hornsby Ku-ring-gai & Hills District Cricket Umpires Association."
>
	<SecondryHero
		title="A Brief History HKHDCUA"
		subtitle="About HKHDCUA"
		description="The Association as formed in 1989 and incorporated in 2008 to administer, promote and manage the development of cricket umpires within the Hornsby Ku- Ring- Gai & Hills District Cricket Association."
		image="./src/asset/images/ball.png"
		link=""
		linkText=""
	/>
	<div
		class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20"
	>
		<div
			class="grid gap-8 row-gap-5 mb-8 md:row-gap-8 lg:grid-cols-2 sm:grid-cols-2"
		>
			<FactCard
				title="Who we are"
				description="The Association as formed in 1989 and incorporated in 2008 to administer, promote and manage the development of cricket umpires within the Hornsby Ku- Ring- Gai & Hills District Cricket Association."
			/>
			<FactCard
				title="What we do"
				description="We provide umpires for the Senior, Junior (finals) and Representative Competitions as our primary responsibility. Training courses for Captains, players and managers are offered in addition to continuing education seminars for our umpires."
			/>
		</div>
	</div>
	<OfficeBearers
		title="Current Office Bearers of the HKHDCUA"
		subtitle="Office Bearers"
		bearers={bearers}
	/>
</MainLayout>
