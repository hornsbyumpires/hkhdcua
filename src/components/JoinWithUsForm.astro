---
export interface Props {
	firstName: string;
	lastName: string;
	email: string;
	mobile: string;
	comments: string;
	ctaText: string;
	description: string;
}

const { firstName, lastName, email, mobile, comments, description, ctaText } =
	Astro.props as Props;
---

<form>
	<div class="mb-1 sm:mb-2">
		<label for="firstName" class="inline-block mb-1 font-medium">
			{firstName}
		</label>
		<input
			placeholder="John"
			required
			type="text"
			class="flex-grow w-full h-12 px-4 mb-2 transition duration-200 bg-white border border-gray-300 rounded shadow-sm appearance-none focus:border-deep-blue-accent-400 focus:outline-none focus:shadow-outline"
			id="firstName"
			name="firstName"
		/>
	</div>
	<div class="mb-1 sm:mb-2">
		<label for="lastName" class="inline-block mb-1 font-medium">
			{lastName}
		</label>
		<input
			placeholder="Doe"
			required
			type="text"
			class="flex-grow w-full h-12 px-4 mb-2 transition duration-200 bg-white border border-gray-300 rounded shadow-sm appearance-none focus:border-deep-blue-accent-400 focus:outline-none focus:shadow-outline"
			id="lastName"
			name="lastName"
		/>
	</div>
	<div class="mb-1 sm:mb-2">
		<label for="email" class="inline-block mb-1 font-medium">{email}</label>
		<input
			placeholder="john.doe@example.org"
			required
			type="text"
			class="flex-grow w-full h-12 px-4 mb-2 transition duration-200 bg-white border border-gray-300 rounded shadow-sm appearance-none focus:border-deep-blue-accent-400 focus:outline-none focus:shadow-outline"
			id="email"
			name="email"
		/>
	</div>
	<div class="mb-1 sm:mb-2">
		<label for="email" class="inline-block mb-1 font-medium">{mobile}</label>
		<input
			placeholder="0401 000 000"
			required
			type="number"
			class="flex-grow w-full h-12 px-4 mb-2 transition duration-200 bg-white border border-gray-300 rounded shadow-sm appearance-none focus:border-deep-blue-accent-400 focus:outline-none focus:shadow-outline"
			id="mobile"
			name="mobile"
		/>
	</div>
	<div class="mb-1 sm:mb-2">
		<label for="comments" class="inline-block mb-1 font-medium">
			{comments}
		</label>
		<textarea
			placeholder="comments"
			required
			class="flex-grow w-full h-12 px-4 mb-2 transition duration-200 bg-white border border-gray-300 rounded shadow-sm appearance-none focus:border-deep-blue-accent-400 focus:outline-none focus:shadow-outline"
			id="comments"
			name="comments"></textarea>
	</div>
	<div class="mt-4 mb-2 sm:mb-4">
		<button
			type="submit"
			class="inline-flex items-center justify-center w-full h-12 px-6 font-medium tracking-wide text-white transition duration-200 rounded shadow-md hover:text-blue-accent-400 bg-blue-accent-400 hover:bg-white focus:shadow-outline focus:outline-none"
		>
			{ctaText}
		</button>
	</div>
	<p class="text-xs text-gray-600 sm:text-sm">
		{description}
	</p>
</form>
