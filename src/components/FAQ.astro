---
import { Picture } from "@astrojs/image/components";

interface FAQ {
	question: string;
	answer: string;
}

export interface Props {
	title: string;
	subtitle: string;
	faqs: FAQ[];
}

const { title, subtitle, faqs } = Astro.props as Props;
---

<div
	class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20"
>
	<div class="max-w-xl sm:mx-auto lg:max-w-2xl">
		<div
			class="flex flex-col items-center max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12"
		>
			<p
				class="inline-block px-6 py-2 mb-4 text-xs font-semibold tracking-wider text-white uppercase rounded-full bg-blue-accent-400"
			>
				{subtitle}
			</p>
			<h2
				class="max-w-lg mb-6 font-sans text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl sm:leading-none"
			>
				{title}
			</h2>
		</div>
		<div id="faqContainer" class="space-y-4">
			{
				faqs.map((faq: FAQ, index: number) => (
					<div data-faq class="border rounded shadow-sm">
						<button
							type="button"
							aria-label="Open item"
							title="Open item"
							class="flex items-center justify-between w-full p-4 focus:outline-none"
							data-clicked="false"
						>
							<p class="text-lg font-medium text-left pointer-events-none w-11/12">{faq.question}</p>
							<div class="flex items-center justify-center w-8 h-8 border rounded-full pointer-events-none">
								<svg
									data-svg
									viewBox="0 0 24 24"
									class="w-3 text-gray-600 transition-transform duration-200 pointer-events-none"
								>
									<polyline
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-miterlimit="10"
										points="2,7 12,17 22,7"
										stroke-linejoin="round"
									/>
								</svg>
							</div>
						</button>
						<div data-content class="answer p-4 pt-0 hidden">
							<p class="text-gray-700">{faq.answer}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</div>

<script>
	import "../scripts/faq.js";
</script>
