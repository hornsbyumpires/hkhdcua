---
import { Picture } from "@astrojs/image/components";

// component imports
import Link from "./Link.astro";

interface Props {
	title: string;
	description: string;
	date: string;
	image: {
		src: string;
		alt: string;
	};
	cta: {
		text: string;
		link: string;
	};
}

const { title, description, date, image, cta } = Astro.props as Props;
---

<div class="p-5">
	<Picture
		src={image.src}
		alt={image.alt}
		widths={[200, 400, 800]}
		sizes="(max-width: 800px) 100vw, 800px"
		aspectRatio="1:1"
		class:list={"object-cover w-full rounded shadow-lg"}
	/>
	<p class="mt-4 mb-2 text-xs font-semibold text-gray-600 uppercase">
		{date}
	</p>
	<p class="mb-3 text-black text-xl font-bold leading-5">{title}</p>
	<p class="mb-4 text-sm text-gray-700">
		{description}
	</p>
	<Link text={cta.text} href={cta.link} style="primary" isFilled={true} />
</div>
