---
export interface Props {
	title: string;
	subtitle: string;
	bodyCopy: string;
}

const { title, subtitle, bodyCopy } = Astro.props;
---

<div
	class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20"
>
	<div class="max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12">
		<div>
			<p
				class="inline-block px-6 py-2 mb-4 text-xs font-semibold tracking-wider text-white uppercase rounded-full bg-blue-accent-400"
			>
				{subtitle}
			</p>
		</div>
		<h2
			class="max-w-lg mb-6 font-sans text-3xl font-bold leading-none tracking-tight text-gray-900 sm:text-4xl md:mx-auto"
		>
			{title}
		</h2>
		<p class="text-base text-gray-700 md:text-lg">{bodyCopy}</p>
	</div>

	<p id="appt-status" class="text-center text-gray-700"></p>
	<noscript>
		<p class="text-center text-gray-700">
			Please turn on JavaScript to see the appointments.
		</p>
	</noscript>

	<!-- Hidden until the sheet has loaded. -->
	<div id="appt-roster" class="grid hidden w-full max-w-6xl gap-4 mx-auto">
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2.5">
			<label for="appt-find" class="text-sm font-bold text-gray-900">Find your name</label>
			<input
				id="appt-find"
				type="search"
				placeholder="Umpire, club or ground"
				autocomplete="off"
				class="flex-1 min-w-0 basis-full sm:basis-0 sm:max-w-xs px-3.5 py-2.5 text-sm font-medium text-gray-900 bg-white border border-gray-300 rounded-lg focus:outline focus:outline-2 focus:outline-offset-1 focus:outline-blue-accent-400 focus:border-transparent"
			/>
			<output id="appt-count" for="appt-find" class="text-sm font-semibold text-gray-600"
			></output>
		</div>

		<!-- A table on large screens. Below that, each row stacks into a small card. -->
		<div
			id="appt-list"
			role="table"
			aria-label="Umpire appointments"
			class="grid gap-3 lg:gap-0 lg:border lg:border-gray-300 lg:rounded-lg lg:overflow-hidden"
		>
			<!-- Column widths must match the row template below. -->
			<div
				role="row"
				class="hidden lg:grid lg:grid-cols-[150px_110px_minmax(0,1.5fr)_minmax(0,1.2fr)_150px_minmax(0,1fr)] gap-4 px-5 py-3 text-xs font-bold tracking-widest text-white uppercase bg-blue-900"
			>
				<span role="columnheader">Date</span>
				<span role="columnheader">Grade</span>
				<span role="columnheader">Match</span>
				<span role="columnheader">Ground</span>
				<span role="columnheader">Time</span>
				<span role="columnheader">Umpires</span>
			</div>
			<p id="appt-empty" class="hidden p-5 text-sm text-gray-600 lg:border-t lg:border-gray-300">
				No appointments match that name. Check the spelling, or clear the box to see every
				match.
			</p>
		</div>
	</div>
</div>

<!-- One blank row. The script copies it for each match and fills in the text.
     Column widths must match the table header above. -->
<template id="appt-row">
	<div
		role="row"
		class="grid items-start grid-cols-2 px-4 text-sm text-gray-800 bg-white border border-gray-300 gap-x-4 gap-y-2.5 py-3.5 rounded-lg lg:grid-cols-[150px_110px_minmax(0,1.5fr)_minmax(0,1.2fr)_150px_minmax(0,1fr)] lg:gap-4 lg:px-5 lg:rounded-none lg:border-0 lg:border-t lg:odd:bg-gray-50"
	>
		<div role="cell" class="grid min-w-0 gap-0.5">
			<span class="font-bold text-gray-900" data-field="day1"></span>
			<span class="text-xs font-medium text-gray-600" data-field="day2"></span>
		</div>

		<div role="cell" class="grid min-w-0 gap-0.5 justify-items-end text-right lg:justify-items-start lg:text-left">
			<span
				class="px-2 py-0.5 text-xs font-bold text-blue-900 whitespace-nowrap rounded bg-blue-50"
				data-field="grade"></span>
			<span class="text-xs text-gray-600" data-field="matchPlay"></span>
		</div>

		<div role="cell" class="min-w-0 col-span-2 lg:col-span-1">
			<span class="text-base font-bold leading-snug text-gray-900 lg:text-sm">
				<span data-field="home"></span>
				<span class="font-medium text-gray-600">v</span>
				<span data-field="away"></span>
			</span>
		</div>

		<div
			role="cell"
			class="grid min-w-0 col-span-2 grid-cols-[64px_1fr] items-baseline gap-2 lg:col-span-1 lg:grid-cols-1 lg:gap-0.5"
		>
			<span class="text-xs text-gray-500 lg:hidden">Ground</span>
			<span data-field="ground"></span>
		</div>

		<div
			role="cell"
			class="grid min-w-0 col-span-2 grid-cols-[64px_1fr] items-baseline gap-2 lg:col-span-1 lg:grid-cols-1 lg:gap-0.5"
		>
			<span class="text-xs text-gray-500 lg:hidden">Time</span>
			<span class="tabular-nums" data-field="times"></span>
		</div>

		<div
			role="cell"
			class="grid min-w-0 col-span-2 grid-cols-[64px_1fr] items-baseline gap-2 pt-2.5 border-t border-gray-300 border-dashed lg:col-span-1 lg:grid-cols-1 lg:gap-0.5 lg:pt-0 lg:border-0"
		>
			<span
				class="text-xs text-gray-500 lg:hidden"
				data-field="umpsLabel"></span>
			<ul class="grid gap-0.5 font-semibold text-gray-900" data-field="umps"></ul>
		</div>
	</div>
</template>

<script>
	// The published CSV link from File → Share → Publish to web.
	const CSV_URL =
		"https://docs.google.com/spreadsheets/d/e/2PACX-1vScRb9q7SLrToTA7hyNoVOi5NpEpk5CwHv8_LFujlPjdUrIDmoPGofVJaVqWfB2CQRaHo_JL8d7HY5a/pub?gid=0&single=true&output=csv";

	const status = document.getElementById("appt-status")!;
	const roster = document.getElementById("appt-roster")!;
	const empty = document.getElementById("appt-empty")!;
	const find = document.getElementById("appt-find") as HTMLInputElement;
	const count = document.getElementById("appt-count")!;
	const template = document.getElementById("appt-row") as HTMLTemplateElement;

	// Rows that match "Find your name" get a blue bar down the left edge.
	const HIT_CLASS = "shadow-[inset_4px_0_0_#2979ff]";

	const MONTHS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];

	// Turns CSV text into rows of cells.
	// Handles commas inside quotes, e.g. "Smith Oval, Pennant Hills".
	function parseCsv(text: string): string[][] {
		const rows: string[][] = [];
		let row: string[] = [];
		let cell = "";
		let inQuotes = false;

		for (let i = 0; i < text.length; i++) {
			const c = text[i];
			if (inQuotes) {
				if (c === '"' && text[i + 1] === '"') {
					cell += '"';
					i++;
				} else if (c === '"') {
					inQuotes = false;
				} else {
					cell += c;
				}
			} else if (c === '"') {
				inQuotes = true;
			} else if (c === ",") {
				row.push(cell);
				cell = "";
			} else if (c === "\n") {
				row.push(cell);
				rows.push(row);
				row = [];
				cell = "";
			} else if (c !== "\r") {
				cell += c;
			}
		}
		row.push(cell);
		rows.push(row);
		return rows;
	}

	// A date with no year belongs to the current cricket season:
	// July–December is the season's first year, January–June the next.
	function seasonYear(month: number): number {
		const now = new Date();
		const seasonStart = now.getMonth() >= 6 ? now.getFullYear() : now.getFullYear() - 1;
		return month >= 6 ? seasonStart : seasonStart + 1;
	}

	// Reads "19-Sep", "19 Sep 2026", "Sat 19th September", "19/9/2026" or "Sat 19/9/2026".
	// Returns null for anything else, e.g. "N/a" or a US-style "9/27/2025".
	function parseDate(text: string): Date | null {
		let day: number;
		let month: number;
		let year: number | null = null;

		const numeric = text.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
		const named = text.match(/(\d{1,2})(?:st|nd|rd|th)?[\s-]+([a-z]{3})[a-z]*(?:[\s-]+(\d{4}))?/i);

		if (numeric) {
			day = Number(numeric[1]);
			month = Number(numeric[2]) - 1;
			year = Number(numeric[3]);
		} else if (named) {
			day = Number(named[1]);
			month = MONTHS.indexOf(named[2].toLowerCase());
			if (month === -1) return null;
			if (named[3]) year = Number(named[3]);
		} else {
			return null;
		}

		if (year === null) year = seasonYear(month);
		const date = new Date(year, month, day);
		return date.getDate() === day && date.getMonth() === month ? date : null;
	}

	// "Sat 19 Sep"
	function formatDate(date: Date): string {
		return date.toLocaleDateString("en-AU", {
			weekday: "short",
			day: "numeric",
			month: "short",
		});
	}

	// One umpire line: the name, or "To be confirmed" if the cell is blank.
	function umpireItem(name: string): HTMLLIElement {
		const item = document.createElement("li");
		if (name && !/^(tbc|tba)$/i.test(name)) {
			item.textContent = name;
		} else {
			item.textContent = "To be confirmed";
			item.className = "italic font-medium text-gray-600";
		}
		return item;
	}

	// "1 match", "6 matches"
	function matchCount(n: number): string {
		return n === 1 ? "1 match" : `${n} matches`;
	}

	async function load() {
		status.textContent = "Loading appointments…";

		try {
			const response = await fetch(CSV_URL, { cache: "no-store" });
			if (!response.ok) throw new Error("HTTP " + response.status);

			const [headings, ...rows] = parseCsv(await response.text());

			// Find each column by its heading, so columns can be moved.
			// Ignores case and extra spaces, e.g. "umpire  1" still matches.
			const tidy = (h: string) => h.trim().toUpperCase().replace(/\s+/g, " ");
			const col = (name: string) => headings.findIndex((h) => tidy(h) === name);
			const get = (row: string[], name: string) => (row[col(name)] ?? "").trim();

			if (col("DAY 1") === -1 || col("HOME") === -1 || col("AWAY") === -1) {
				throw new Error("The sheet is missing a Day 1, Home or Away heading.");
			}

			const today = new Date();
			// today.setMonth(today.getMonth() - 1); // TEMP: remove before committing

			today.setHours(0, 0, 0, 0);
			today.setDate(today.getDate() - 1); // Keep yesterday's games for one extra day

			const matches = rows
				// Skip blank rows.
				.filter((row) => get(row, "DAY 1") || get(row, "HOME") || get(row, "AWAY"))
				.map((row) => ({
					row,
					day1: parseDate(get(row, "DAY 1")),
					day2: parseDate(get(row, "DAY 2")), // "N/a" → no second day
				}))
				// Hide games whose last day has passed. Keep rows with unreadable dates.
				.filter(({ day1, day2 }) => {
					const lastDay = day2 ?? day1;
					return !lastDay || lastDay >= today;
				})
				// Earliest first. Unreadable dates go last.
				.sort((a, b) => (a.day1?.getTime() ?? 9e15) - (b.day1?.getTime() ?? 9e15));

			if (matches.length === 0) {
				status.textContent = "No upcoming appointments.";
				return;
			}

			// Each row with its searchable text, for "Find your name".
			const shownRows: { el: HTMLElement; search: string }[] = [];

			for (const { row, day1, day2 } of matches) {
				const card = template.content.cloneNode(true) as DocumentFragment;
				const field = (name: string) => card.querySelector<HTMLElement>(`[data-field="${name}"]`)!;

				// Blank cells show as "TBC".
				const set = (name: string, value: string) => {
					field(name).textContent = value || "TBC";
				};

				set("day1", day1 ? formatDate(day1) : get(row, "DAY 1"));
				if (day2) field("day2").textContent = `& ${formatDate(day2)}`;
				else field("day2").remove();
				set("grade", get(row, "GRADE"));
				set("matchPlay", get(row, "MATCH PLAY"));
				set("home", get(row, "HOME"));
				set("away", get(row, "AWAY"));
				set("ground", get(row, "GROUND"));

				// "12:30pm – 6:00pm". Either time on its own can be TBC.
				const start = get(row, "START TIME");
				const end = get(row, "END TIME");
				const endIsTime = /\d:\d\d|\d\s*(am|pm)/i.test(end);
				if (endIsTime) {
					set("times", `${start || "TBC"} – ${end}`);
				} else {
					set("times", start);
					if (end) {
						const overs = document.createElement("span");
						overs.className = "block text-xs text-gray-600";
						overs.textContent = end;
						field("times").append(overs);
					}
				}

				// "None" means a one-umpire game, so the second umpire isn't listed.
				// A blank cell means not appointed yet, so it shows "To be confirmed".
				const umpires = [get(row, "UMPIRE 1"), get(row, "UMPIRE 2")];
				if (umpires[1].toLowerCase() === "none") umpires.pop();
				set("umpsLabel", umpires.length > 1 ? "Umpires" : "Umpire");
				field("umps").append(...umpires.map(umpireItem));

				shownRows.push({
					el: card.firstElementChild as HTMLElement,
					search: [get(row, "HOME"), get(row, "GRADE"), get(row, "AWAY"), get(row, "GROUND"), ...umpires]
						.join(" ")
						.toLowerCase(),
				});

				empty.before(card);
			}

			// Hides rows that don't mention the name.
			const filter = () => {
				const query = find.value.trim().toLowerCase();
				let shown = 0;
				for (const { el, search } of shownRows) {
					const hit = !query || search.includes(query);
					el.classList.toggle("hidden", !hit);
					el.classList.toggle(HIT_CLASS, Boolean(query) && hit);
					if (hit) shown++;
				}
				empty.classList.toggle("hidden", shown > 0);
				count.textContent = query
					? `${shown} of ${matchCount(shownRows.length)}`
					: matchCount(shownRows.length);
			};

			find.addEventListener("input", filter);
			filter();

			status.textContent = "";
			roster.classList.remove("hidden");
		} catch (error) {
			console.error(error);
			status.textContent = "Sorry, the appointments couldn't be loaded. Please try again later.";
		}
	}

	load();
</script>
