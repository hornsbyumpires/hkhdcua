---
export interface Props {
	title: string;
	subtitle: string;
	bodyCopy: string;
	appointments: Record<string, any>;
}

const { title, subtitle, bodyCopy, appointments } = Astro.props as Props;

function dateConvert(date: string): string {
	const match = date.match(/Date\((\d+),(\d+),(\d+)\)/);
	if (match?.includes('1900')) {
		return 'true';
	} else if (match) {
		const year = parseInt(match[1]);
		const month = parseInt(match[2]) + 1;
		const day = parseInt(match[3]);
		return `${year}/${month.toString().padStart(2, "0")}/${day
			.toString()
			.padStart(2, "0")}`;
	} else {
		return "Invalid date format.";
	}
}
function timeConvert(time: string): string {
	const match = time.match(/Date\((\d+),(\d+),(\d+),(\d+),(\d+),(\d+)\)/);
	if (match) {
		const year = parseInt(match[1]);
		const month = parseInt(match[2]) + 1;
		const day = parseInt(match[3]);
		const hour = parseInt(match[4]);
		const minute = parseInt(match[5]);
		const second = parseInt(match[6]);

		const date = new Date(year, month, day, hour, minute, second);
		const formattedTime = date.toLocaleTimeString("en-AU", {
			hour12: true,
			hour: '2-digit',
			minute:'2-digit'
		});
		return formattedTime;
	} else {
		return "Invalid time format.";
	}
}
