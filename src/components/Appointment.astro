---
export interface Props {
	title: string;
	subtitle: string;
	bodyCopy: string;
	appointments: Record<string, any>;
}

const { title, subtitle, bodyCopy, appointments } = Astro.props as Props;
---

<div
	class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20"
>
	<div class="max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12">
		<div>
			<p
				class="inline-block px-6 py-2 mb-4 text-xs font-semibold tracking-wider text-white uppercase rounded-full bg-blue-accent-400"
			>
				{subtitle}
			</p>
		</div>
		<h2
			class="max-w-lg mb-6 font-sans text-3xl font-bold leading-none tracking-tight text-gray-900 sm:text-4xl md:mx-auto"
		>
			{title}
		</h2>
		<p class="text-base text-gray-700 md:text-lg">
			{bodyCopy}
		</p>
	</div>
	<div class="grid gap-4 row-gap-5 sm:grid-cols-2 lg:grid-cols-4">
		{
			Object.values(appointments).map(
				(appointment, index) =>
					index !== 0 && (
						<div class="flex flex-col justify-between p-5 border rounded shadow-sm">
							<div>
								<div class="flex items-center justify-center w-16 h-16 mb-4 rounded-full bg-indigo-50">
									<svg
										viewBox="0 0 52 52"
										fill="currentColor"
										class="w-12 h-12 text-blue-accent-400"
									>
										<path d="M11.7 2.805a.75.75 0 0 1 .6 0A60.65 60.65 0 0 1 22.83 8.72a.75.75 0 0 1-.231 1.337 49.948 49.948 0 0 0-9.902 3.912l-.003.002c-.114.06-.227.119-.34.18a.75.75 0 0 1-.707 0A50.88 50.88 0 0 0 7.5 12.173v-.224c0-.131.067-.248.172-.311a54.615 54.615 0 0 1 4.653-2.52.75.75 0 0 0-.65-1.352 56.123 56.123 0 0 0-4.78 2.589 1.858 1.858 0 0 0-.859 1.228 49.803 49.803 0 0 0-4.634-1.527.75.75 0 0 1-.231-1.337A60.653 60.653 0 0 1 11.7 2.805Z" />
										<path d="M13.06 15.473a48.45 48.45 0 0 1 7.666-3.282c.134 1.414.22 2.843.255 4.284a.75.75 0 0 1-.46.711 47.87 47.87 0 0 0-8.105 4.342.75.75 0 0 1-.832 0 47.87 47.87 0 0 0-8.104-4.342.75.75 0 0 1-.461-.71c.035-1.442.121-2.87.255-4.286.921.304 1.83.634 2.726.99v1.27a1.5 1.5 0 0 0-.14 2.508c-.09.38-.222.753-.397 1.11.452.213.901.434 1.346.66a6.727 6.727 0 0 0 .551-1.607 1.5 1.5 0 0 0 .14-2.67v-.645a48.549 48.549 0 0 1 3.44 1.667 2.25 2.25 0 0 0 2.12 0Z" />
										<path d="M4.462 19.462c.42-.419.753-.89 1-1.395.453.214.902.435 1.347.662a6.742 6.742 0 0 1-1.286 1.794.75.75 0 0 1-1.06-1.06Z" />
									</svg>
								</div>
								<p class="mb-2 font-semibold leading-5 flex flex-row gap-1 justify-start items-center">
									<span class="text-xs text-gray-800">
										Competition:
									</span>
									<span class="text-sm">
										{Object.values(appointment["c"])[0]?.v}
									</span>
								</p>
								<p class="mb-2 font-semibold leading-5 flex flex-row gap-1 justify-start items-center">
									<span class="text-xs text-gray-800">
										Round:
									</span>
									<span class="text-sm">
										{Object.values(appointment["c"])[1]?.v}
									</span>
								</p>
								<p class="mb-2 font-semibold leading-5 flex flex-row gap-1 justify-start items-center">
									<span class="text-xs text-gray-800">
										Umpire 1:
									</span>
									<span class="text-sm">
										{Object.values(appointment["c"])[2]?.v}
									</span>
								</p>
								<p class="mb-2 font-semibold leading-5 flex flex-row gap-1 justify-start items-center">
									<span class="text-xs text-gray-800">
										Umpire 2:
									</span>
									<span class="text-sm">
										{Object.values(appointment["c"])[3]?.v}
									</span>
								</p>
								<p class="mb-2 font-semibold leading-5 flex flex-row gap-1 justify-start items-center">
									<span class="text-xs text-gray-800">
										Home Team:
									</span>
									<span class="text-sm">
										{Object.values(appointment["c"])[4]?.v}
									</span>
								</p>
								<p class="mb-2 font-semibold leading-5 flex flex-row gap-1 justify-start items-center">
									<span class="text-xs text-gray-800">
										Away Team:
									</span>
									<span class="text-sm">
										{Object.values(appointment["c"])[5]?.v}
									</span>
								</p>
								<p class="mb-2 font-semibold leading-5 flex flex-row gap-1 justify-start items-center">
									<span class="text-xs text-gray-800">
										Venue:
									</span>
									<span class="text-sm">
										{Object.values(appointment["c"])[6]?.v}
									</span>
								</p>
							</div>
						</div>
					)
			)
		}
	</div>
</div>
