---
export interface Props {
	title: string;
	subtitle: string;
	bodyCopy: string;
}

const { title, subtitle, bodyCopy } = Astro.props;
---

<div
	class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20"
>
	<div class="max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12">
		<div>
			<p
				class="inline-block px-6 py-2 mb-4 text-xs font-semibold tracking-wider text-white uppercase rounded-full bg-blue-accent-400"
			>
				{subtitle}
			</p>
		</div>
		<h2
			class="max-w-lg mb-6 font-sans text-3xl font-bold leading-none tracking-tight text-gray-900 sm:text-4xl md:mx-auto"
		>
			{title}
		</h2>
		<p class="text-base text-gray-700 md:text-lg">{bodyCopy}</p>
	</div>

	<p id="appt-status" class="text-center text-gray-700"></p>
	<noscript>
		<p class="text-center text-gray-700">
			Please turn on JavaScript to see the appointments.
		</p>
	</noscript>

	<div
		id="appt-list"
		class="grid gap-4 row-gap-5 sm:grid-cols-2 lg:grid-cols-4"
	>
	</div>
</div>

<!-- One blank card. The script copies it for each match and fills in the text. -->
<template id="appt-card">
	<div class="flex flex-col justify-between p-4 border rounded shadow-sm">
		<div>
			<div
				class="flex items-center justify-center w-16 h-16 mb-4 rounded-full bg-blue-50 p-2"
			>
				<img src="/cricket-ball.svg" alt="" class="w-12 h-12" />
			</div>
			<div class="flex flex-row justify-between border-b-2 mb-2">
				<p class="mb-2">
					<span class="text-xs text-gray-800">Grade:</span><br />
					<span class="text-sm font-bold" data-field="grade"></span>
				</p>
				<p class="mb-2">
					<span class="text-xs text-gray-800">Game Type:</span><br />
					<span class="text-sm font-bold" data-field="gameType"
					></span>
				</p>
				<p class="mb-2">
					<span class="text-xs text-gray-800">Round:</span><br />
					<span class="text-sm font-bold" data-field="round"></span>
				</p>
			</div>
			<div class="flex flex-row justify-between">
				<p class="mb-2">
					<span class="text-xs text-gray-800">Date:</span><br />
					<span class="text-sm font-bold" data-field="dates"></span>
				</p>
				<p class="mb-2">
					<span class="text-xs text-gray-800">Time:</span><br />
					<span class="text-sm font-bold" data-field="time"></span>
				</p>
			</div>
			<table
				class="w-full text-xs text-left rtl:text-right text-gray-500 dark:text-gray-400 mb-2"
			>
				<thead class="text-xs text-white uppercase bg-blue-700">
					<tr>
						<th scope="col" class="px-2 py-3">Umpire 1</th>
						<th scope="col" class="px-2 py-3">Umpire 2</th>
					</tr>
				</thead>
				<tbody>
					<tr class="bg-blue-400 text-white">
						<td class="px-2 py-3" data-field="ump1"></td>
						<td class="px-2 py-3" data-field="ump2"></td>
					</tr>
				</tbody>
			</table>
			<p class="mb-2 flex flex-row gap-1 justify-start items-center">
				<span class="text-xs text-gray-800">Venue:</span>
				<span class="text-xs font-bold" data-field="ground"></span>
			</p>
			<p class="mb-2 flex flex-row gap-1 justify-start items-center">
				<span class="text-xs text-gray-800">Home Team:</span>
				<span class="text-xs font-bold" data-field="home"></span>
			</p>
			<p class="mb-2 flex flex-row gap-1 justify-start items-center">
				<span class="text-xs text-gray-800">Away Team:</span>
				<span class="text-xs font-bold" data-field="away"></span>
			</p>
		</div>
	</div>
</template>

<script>
	// The published CSV link from File → Share → Publish to web.
	const CSV_URL =
		"https://docs.google.com/spreadsheets/d/e/2PACX-1vQG730S_zxeaZmqMXGNB5lNEvrSGII0_v4twTvKi6OdkjTHT_TM8WXyheC2pPVuaW1BpeGoTtWMcZDN/pub?gid=0&single=true&output=csv";

	const status = document.getElementById("appt-status")!;
	const list = document.getElementById("appt-list")!;
	const template = document.getElementById(
		"appt-card"
	) as HTMLTemplateElement;

	// Turns CSV text into rows of cells.
	// Handles commas inside quotes, e.g. "Smith Oval, Pennant Hills".
	function parseCsv(text: string): string[][] {
		const rows: string[][] = [];
		let row: string[] = [];
		let cell = "";
		let inQuotes = false;

		for (let i = 0; i < text.length; i++) {
			const c = text[i];
			if (inQuotes) {
				if (c === '"' && text[i + 1] === '"') {
					cell += '"';
					i++;
				} else if (c === '"') {
					inQuotes = false;
				} else {
					cell += c;
				}
			} else if (c === '"') {
				inQuotes = true;
			} else if (c === ",") {
				row.push(cell);
				cell = "";
			} else if (c === "\n") {
				row.push(cell);
				rows.push(row);
				row = [];
				cell = "";
			} else if (c !== "\r") {
				cell += c;
			}
		}
		row.push(cell);
		rows.push(row);
		return rows;
	}

	// Reads "Sat 8/11/2025" or "8/11/2025". Returns null if it isn't a real date,
	// e.g. a US-style "9/27/2025".
	function parseDate(text: string): Date | null {
		const m = text.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
		if (!m) return null;
		const day = Number(m[1]);
		const month = Number(m[2]) - 1;
		const date = new Date(Number(m[3]), month, day);
		return date.getDate() === day && date.getMonth() === month
			? date
			: null;
	}

	// "Sat 8 Nov"
	function formatDate(date: Date): string {
		return date.toLocaleDateString("en-AU", {
			weekday: "short",
			day: "numeric",
			month: "short",
		});
	}

	async function load() {
		status.textContent = "Loading appointments…";

		try {
			const response = await fetch(CSV_URL, { cache: "no-store" });
			if (!response.ok) throw new Error("HTTP " + response.status);

			const [headings, ...rows] = parseCsv(await response.text());

			// Find each column by its heading, so the secretary can move columns.
			const col = (name: string) =>
				headings.findIndex((h) => h.trim().toUpperCase() === name);
			const get = (row: string[], name: string) =>
				(row[col(name)] ?? "").trim();

			if (
				col("DATE") === -1 ||
				col("HOME") === -1 ||
				col("AWAY") === -1
			) {
				throw new Error(
					"The sheet is missing a DATE, HOME or AWAY heading."
				);
			}

			const today = new Date();
			today.setHours(0, 0, 0, 0);

			const matches = rows
				// Skip blank rows.
				.filter(
					(row) =>
						get(row, "DATE") || get(row, "HOME") || get(row, "AWAY")
				)
				.map((row) => ({
					row,
					day1: parseDate(get(row, "DATE")),
					day2: parseDate(get(row, "DAY 2")),
				}))
				// Hide games whose last day has passed. Keep rows with unreadable dates.
				.filter(({ day1, day2 }) => {
					const lastDay = day2 ?? day1;
					return !lastDay || lastDay >= today;
				})
				// Earliest first. Unreadable dates go last.
				.sort(
					(a, b) =>
						(a.day1?.getTime() ?? 9e15) -
						(b.day1?.getTime() ?? 9e15)
				);

			if (matches.length === 0) {
				status.textContent = "No upcoming appointments.";
				return;
			}

			for (const { row, day1, day2 } of matches) {
				const card = template.content.cloneNode(
					true
				) as DocumentFragment;

				// Blank cells show as "TBC".
				const set = (field: string, value: string) => {
					card.querySelector(`[data-field="${field}"]`)!.textContent =
						value || "TBC";
				};

				let dates = get(row, "DATE");
				if (day1)
					dates = day2
						? `${formatDate(day1)} & ${formatDate(day2)}`
						: formatDate(day1);

				set("grade", get(row, "GRADE"));
				set("gameType", get(row, "GAME TYPE"));
				set("round", get(row, "ROUND"));
				set("dates", dates);
				set("time", get(row, "TIME"));
				set("ump1", get(row, "UMP1"));
				set("ump2", get(row, "UMP2"));
				set("ground", get(row, "GROUND"));
				set("home", get(row, "HOME"));
				set("away", get(row, "AWAY"));

				list.append(card);
			}

			status.textContent = "";
		} catch (error) {
			console.error(error);
			status.textContent =
				"Sorry, the appointments couldn't be loaded. Please try again later.";
		}
	}

	load();
</script>
