---
// components import
import Link from "./Link.astro";

export interface Props {
	title: string;
	subtitle: string;
	href: string;
	ctaText: string;
}

const { href, title, subtitle, ctaText } = Astro.props as Props;
---

<div class="max-w-full bg-cover bg-hero-bg">
	<div class="bg-blue-accent-100 bg-opacity-75">
		<div class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20">
			<div class="max-w-xl sm:mx-auto lg:max-w-2xl">
				<div class="flex flex-col mb-16 sm:text-center sm:mb-0">
					<div class="max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12">
						<h4 class="mb-6 font-sans text-1xl font-bold leading-none tracking-tight text-white sm:text-1xl md:mx-auto">
							{subtitle}
						</h4>
						<h1 class="mb-6 font-sans text-4xl font-bold leading-none tracking-tight text-white sm:text-5xl md:mx-auto">
							{title}
						</h1>
					</div>
					<div>
						<Link text={ctaText} href={href} style="primary" isFilled={true} />
					</div>
				</div>
			</div>
		</div>
	</div>
</div>;

