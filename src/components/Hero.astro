---
export interface Props {
	title: string;
	subtitle: string;
	href: string;
	ctaText: string;
}

const { href, title, subtitle, ctaText } = Astro.props;
---

<div class="max-w-full bg-cover bg-hero-bg">
	<div class="bg-blue-accent-100 bg-opacity-75">
		<div
			class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20"
		>
			<div class="max-w-xl sm:mx-auto lg:max-w-2xl">
				<div class="flex flex-col mb-16 sm:text-center sm:mb-0">
					<div
						class="max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12"
					>
						<h4
							class="mb-6 font-sans text-1xl font-bold leading-none tracking-tight text-white sm:text-1xl md:mx-auto"
						>
							{subtitle}
						</h4>
						<h1
							class="mb-6 font-sans text-4xl font-bold leading-none tracking-tight text-white sm:text-5xl md:mx-auto"
						>
							{title}
						</h1>
					</div>
					<div>
						<a
							href={href}
							class="inline-flex items-center justify-center h-12 px-6 font-semibold tracking-wide text-white transition duration-200 rounded shadow-md hover:text-blue-accent-400 bg-blue-accent-400 hover:bg-blue-50 focus:shadow-outline focus:outline-none"
						>
							{ctaText}
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
