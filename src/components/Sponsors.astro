---
export interface Props {
	title: string;
	subtitle: string;
	body: string;
	sponsorPrimary: {
		title: string;
		body: string;
		image: string;
		link: string;
	};
	sponsorSecondry: {
		title: string;
		body: string;
		image: string;
		link: string;
	};
	sponsorTertiary: {
		title: string;
		body: string;
		image: string;
		link: string;
	};
}

const {
	title,
	subtitle,
	body,
	sponsorPrimary,
	sponsorSecondry,
	sponsorTertiary,
} = Astro.props as Props;
---

<div
	class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20"
>
	<div class="max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12">
		<div>
			<p
				class="inline-block px-3 py-px mb-4 text-xs font-semibold tracking-wider text-white uppercase rounded-full bg-red-accent-400"
			>
				{subtitle}
			</p>
		</div>
		<h2
			class="max-w-lg mb-6 font-sans text-3xl font-bold leading-none tracking-tight text-gray-900 sm:text-4xl md:mx-auto"
		>
			{title}
		</h2>
		<p class="text-base text-gray-700 md:text-lg">
			{body}
		</p>
	</div>
	<div class="grid max-w-screen-lg gap-8 lg:grid-cols-2 sm:mx-auto">
		<div class="flex flex-col justify-center">
			<div class="flex">
				<div class="mr-4">
					<div
						class="flex items-center justify-center w-16 h-16 mb-4 rounded-full bg-blue-50"
					>
						<svg
							class="w-12 h-12 text-blue-accent-400"
							stroke="currentColor"
							viewBox="0 0 52 52"
						>
							<polygon
								stroke-width="3"
								stroke-linecap="round"
								stroke-linejoin="round"
								fill="none"
								points="29 13 14 29 25 29 23 39 38 23 27 23"></polygon>
						</svg>
					</div>
				</div>
				<div>
					<h6 class="mb-2 font-semibold leading-5">
						{sponsorPrimary.title}
					</h6>
					<p class="text-sm text-gray-900">
						{sponsorPrimary.body}
					</p>
					<hr class="w-full my-6 border-gray-300" />
				</div>
			</div>
			<div class="flex">
				<div class="mr-4">
					<div
						class="flex items-center justify-center w-16 h-16 mb-4 rounded-full bg-blue-50"
					>
						<svg
							class="w-12 h-12 text-blue-accent-400"
							stroke="currentColor"
							viewBox="0 0 52 52"
						>
							<polygon
								stroke-width="3"
								stroke-linecap="round"
								stroke-linejoin="round"
								fill="none"
								points="29 13 14 29 25 29 23 39 38 23 27 23"></polygon>
						</svg>
					</div>
				</div>
				<div>
					<h6 class="mb-2 font-semibold leading-5">
						{sponsorSecondry.title}
					</h6>
					<p class="text-sm text-gray-900">
						{sponsorSecondry.body}
					</p>
					<hr class="w-full my-6 border-gray-300" />
				</div>
			</div>
			<div class="flex">
				<div class="mr-4">
					<div
						class="flex items-center justify-center w-16 h-16 mb-4 rounded-full bg-blue-50"
					>
						<svg
							class="w-12 h-12 text-blue-accent-400"
							stroke="currentColor"
							viewBox="0 0 52 52"
						>
							<polygon
								stroke-width="3"
								stroke-linecap="round"
								stroke-linejoin="round"
								fill="none"
								points="29 13 14 29 25 29 23 39 38 23 27 23"></polygon>
						</svg>
					</div>
				</div>
				<div>
					<h6 class="mb-2 font-semibold leading-5">
						{sponsorTertiary.title}
					</h6>
					<p class="text-sm text-gray-900">
						{sponsorTertiary.body}
					</p>
				</div>
			</div>
		</div>
		<div class="grid grid-cols-2 gap-5">
			<a class="p-5 col-span-2 rounded shadow-lg bg-blue-900 flex flex-col justify-center" href={sponsorPrimary.link} target="_self">
				<img
					class="object-cover w-full"
					src={sponsorPrimary.image}
					alt={sponsorPrimary.title}
				/>
			</a>
			<a class="rounded shadow-lg p-5 bg-white flex flex-col justify-center" href={sponsorSecondry.link} target="_self">
				<img
					class="object-cover w-full"
					src={sponsorSecondry.image}
					alt={sponsorSecondry.title}
				/>
			</a>
			<a class="rounded shadow-lg p-5 bg-white flex flex-col justify-center" href={sponsorTertiary.link} target="_self">
				<img
					class="object-cover w-full"
					src={sponsorTertiary.image}
					alt={sponsorTertiary.title}
				/>
			</a>
		</div>
	</div>
</div>
