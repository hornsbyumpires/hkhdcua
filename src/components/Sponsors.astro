			>
				<img
					class="object-cover w-full"
					src={sponsorPrimary.image}
					alt={sponsorPrimary.title}
				/>
			</a>
			<a
				class="rounded shadow-lg p-5 bg-light-blue-900 flex flex-col justify-center"
