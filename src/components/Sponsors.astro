---
export interface Props {
	title: string;
	subtitle: string;
	body: string;
	sponsorPrimary: {
		title: string;
		body: string;
		image: string;
		link: string;
	};
	sponsorSecondry: {
		title: string;
		body: string;
		image: string;
		link: string;
	};
	sponsorTertiary: {
		title: string;
		body: string;
		image: string;
		link: string;
	};
}

const {
	title,
	subtitle,
	body,
	sponsorPrimary,
	sponsorSecondry,
	sponsorTertiary,
} = Astro.props as Props;
import { Picture } from "@astrojs/image/components";
