---
export interface Props {
	copy: string;
	hrefFB: string;
	hrefYoutube: string;
}

const { copy, hrefFB, hrefYoutube } = Astro.props;
---

<div class="bg-gray-900">
	<div
		class="px-4 pt-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8"
	>
		<div class="flex flex-col justify-between pt-5 pb-10 sm:flex-row">
			<p class="text-sm text-gray-500">
				{copy}
			</p>
			<div class="flex items-center mt-4 space-x-4 sm:mt-0">
				<a
					href={hrefYoutube}
					class="text-gray-500 transition-colors duration-300 hover:text-blue-accent-400"
				>
					<svg viewBox="0 0 24 24" fill="currentColor" class="h-5">
						<path
							d="M365.257,67.393H95.744C42.866,67.393,0,110.259,0,163.137v134.728
		c0,52.878,42.866,95.744,95.744,95.744h269.513c52.878,0,95.744-42.866,95.744-95.744V163.137
		C461.001,110.259,418.135,67.393,365.257,67.393z M300.506,237.056l-126.06,60.123c-3.359,1.602-7.239-0.847-7.239-4.568V168.607
		c0-3.774,3.982-6.22,7.348-4.514l126.06,63.881C304.363,229.873,304.298,235.248,300.506,237.056z"
						></path>
					</svg>
				</a>
				<a
					href={hrefFB}
					class="text-gray-500 transition-colors duration-300 hover:text-blue-accent-400"
				>
					<svg viewBox="0 0 24 24" fill="currentColor" class="h-5">
						<path
							d="M22,0H2C0.895,0,0,0.895,0,2v20c0,1.105,0.895,2,2,2h11v-9h-3v-4h3V8.413c0-3.1,1.893-4.788,4.659-4.788 c1.325,0,2.463,0.099,2.795,0.143v3.24l-1.918,0.001c-1.504,0-1.795,0.715-1.795,1.763V11h4.44l-1,4h-3.44v9H22c1.105,0,2-0.895,2-2 V2C24,0.895,23.105,0,22,0z"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</div>
</div>
