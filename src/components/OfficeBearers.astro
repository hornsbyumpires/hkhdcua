---
import { Picture } from "@astrojs/image/components";

export interface Props {
	title: string;
	subtitle: string;
	bearers: Array<{
		name: string;
		title: string;
		mobile: string;
		email: string;
		image: string;
		description: string;
	}>;
}

const { title, subtitle, bearers } = Astro.props as Props;
---

<div
	class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-10"
>
	<div class="max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12">
		<div>
			<p
				class="inline-block px-6 py-2 mb-4 text-xs font-semibold tracking-wider text-white uppercase rounded-full bg-blue-accent-400"
			>
				{subtitle}
			</p>
		</div>
		<h2
			class="max-w-lg mb-6 font-sans text-3xl font-bold leading-none tracking-tight text-gray-900 sm:text-4xl md:mx-auto"
		>
			{title}
		</h2>
	</div>
	<div class="grid gap-10 mx-auto lg:grid-cols-2 lg:max-w-screen-lg">
		{
			bearers.map((bearer) => (
				<div class="grid sm:grid-cols-3">
					<div class="relative w-full h-48 max-h-full rounded shadow sm:h-auto">
						<Picture
							src={bearer.image}
							alt={bearer.name}
							widths={[200, 400, 800]}
							sizes="(max-width: 400px) 100vw, 400px"
							aspectRatio="1:1"
							class={'absolute object-cover w-full h-full rounded'}
						/>
					</div>
					<div class="flex flex-col justify-center mt-5 sm:mt-0 sm:p-5 sm:col-span-2">
						<p class="text-lg font-bold">{bearer.name}</p>
						<p class="mb-4 text-sm text-gray-800">{bearer.title}</p>
						<p class="mb-4 text-xs tracking-wide text-gray-800">
							{bearer.description}
						</p>
						<a
							href={`tel:${bearer.mobile}`}
							class="text-xs text-gray-800 transition-colors duration-300 hover:text-deep-purple-accent-400"
						>
							{bearer.mobile}
						</a>
						<a
							href={`mailto:${bearer.email}`}
							class="text-xs text-gray-800 transition-colors duration-300 hover:text-deep-purple-accent-400"
						>
							{bearer.email}
						</a>
					</div>
				</div>
			))
		}
	</div>
</div>
