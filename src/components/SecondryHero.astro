---
import { Picture, Image } from "@astrojs/image/components";
import Link from "./Link.astro";
interface Props {
	title: string;
	subtitle: string;
	description: string;
	image: string;
	link: string;
	linkText: string;
}

const { title, subtitle, description, image, link, linkText } =
	Astro.props as Props;
---

<div
	class="relative flex flex-col py-20 lg:pt-0 lg:flex-col lg:pb-0 shadow-md border-t-2"
>
	<div
		class="flex flex-col items-start w-full max-w-xl px-4 mx-auto lg:px-8 lg:max-w-screen-xl"
	>
		<div class="mb-16 lg:my-20 lg:max-w-lg lg:pr-5">
			<div class="max-w-xl mb-6">
				<div>
					<p
						class="inline-block px-3 py-px mb-4 text-xs font-semibold tracking-wider text-white uppercase rounded-full bg-red-accent-400"
					>
						{subtitle}
					</p>
				</div>
				<h2
					class="max-w-lg mb-6 font-sans text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl sm:leading-none"
				>
					{title}
				</h2>
				<Fragment set:html={description} />
				{
					linkText && link && (
						<Link text={linkText} href={link} style="primary" isFilled={true} />
					)
				}
			</div>
		</div>
	</div>
	<div
		class="inset-y-0 right-0 w-full max-w-xl px-4 mx-auto lg:pl-8 lg:pr-0 lg:mb-0 lg:mx-0 lg:w-1/2 lg:max-w-full lg:absolute xl:px-0 overflow-hidden"
	>
		<Picture
				src={image}
				alt={title}
				widths={[200, 400, 800]}
				sizes="(max-width: 800px) 100vw, 800px"
				aspectRatio="16:9"
			/>
	</div>
</div>
