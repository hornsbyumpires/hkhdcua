---
export interface Props {
	title: string;
	subtitle: string;
	queratorText: string;
	body: string;
	description: string;
	ctaText: string;
}

const { title, subtitle, queratorText, body, description, ctaText } =
	Astro.props;
---

<div class="relative">
	<img
		src="/images/join-with-us-hero.png"
		class="absolute inset-0 object-cover w-full h-full"
		alt=""
	/>
	<div class="relative bg-opacity-75 bg-blue-accent-700">
		<svg class="absolute inset-x-0 bottom-0 text-white" viewBox="0 0 1160 160">
			<path
				fill="currentColor"
				d="M-164 13L-104 39.7C-44 66 76 120 196 141C316 162 436 152 556 119.7C676 88 796 34 916 13C1036 -8 1156 2 1216 7.7L1276 13V162.5H1216C1156 162.5 1036 162.5 916 162.5C796 162.5 676 162.5 556 162.5C436 162.5 316 162.5 196 162.5C76 162.5 -44 162.5 -104 162.5H-164V13Z"
			></path>
		</svg>
		<div
			class="relative px-4 py-16 mx-auto overflow-hidden sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20"
		>
			<div class="flex flex-col items-center justify-between xl:flex-row">
				<div class="w-full max-w-xl mb-12 xl:mb-0 xl:pr-16 xl:w-7/12">
					<h2
						class="max-w-lg mb-6 font-sans text-3xl font-bold tracking-tight text-white sm:text-4xl sm:leading-none"
					>
						{title}
					</h2>
					<p class="max-w-xl mb-4 text-base text-gray-200 md:text-lg">
						{body}
					</p>
					<p
						class="inline-block p-3 pl-5 pr-5 text-xs font-semibold tracking-wider text-white uppercase rounded-full bg-blue-accent-100"
					>
						{queratorText}
					</p>
				</div>
				<div class="w-full max-w-xl xl:px-8 xl:w-5/12">
					<div class="bg-white rounded shadow-2xl p-7 sm:p-10">
						<h3
							class="mb-4 text-xl font-semibold sm:text-center sm:mb-6 sm:text-2xl"
						>
							{subtitle}
						</h3>
						<form>
							<div class="mb-1 sm:mb-2">
								<label for="firstName" class="inline-block mb-1 font-medium">
									First name
								</label>
								<input
									placeholder="John"
									required
									type="text"
									class="flex-grow w-full h-12 px-4 mb-2 transition duration-200 bg-white border border-gray-300 rounded shadow-sm appearance-none focus:border-deep-blue-accent-400 focus:outline-none focus:shadow-outline"
									id="firstName"
									name="firstName"
								/>
							</div>
							<div class="mb-1 sm:mb-2">
								<label for="lastName" class="inline-block mb-1 font-medium">
									Last name
								</label>
								<input
									placeholder="Doe"
									required
									type="text"
									class="flex-grow w-full h-12 px-4 mb-2 transition duration-200 bg-white border border-gray-300 rounded shadow-sm appearance-none focus:border-deep-blue-accent-400 focus:outline-none focus:shadow-outline"
									id="lastName"
									name="lastName"
								/>
							</div>
							<div class="mb-1 sm:mb-2">
								<label for="email" class="inline-block mb-1 font-medium">
									E-mail
								</label>
								<input
									placeholder="john.doe@example.org"
									required
									type="text"
									class="flex-grow w-full h-12 px-4 mb-2 transition duration-200 bg-white border border-gray-300 rounded shadow-sm appearance-none focus:border-deep-blue-accent-400 focus:outline-none focus:shadow-outline"
									id="email"
									name="email"
								/>
							</div>
							<div class="mb-1 sm:mb-2">
								<label for="email" class="inline-block mb-1 font-medium">
									Mobile
								</label>
								<input
									placeholder="0401 000 000"
									required
									type="number"
									class="flex-grow w-full h-12 px-4 mb-2 transition duration-200 bg-white border border-gray-300 rounded shadow-sm appearance-none focus:border-deep-blue-accent-400 focus:outline-none focus:shadow-outline"
									id="mobile"
									name="mobile"
								/>
							</div>
							<div class="mb-1 sm:mb-2">
								<label for="comments" class="inline-block mb-1 font-medium">
									Comments
								</label>
								<textarea
									placeholder="comments"
									required
									class="flex-grow w-full h-12 px-4 mb-2 transition duration-200 bg-white border border-gray-300 rounded shadow-sm appearance-none focus:border-deep-blue-accent-400 focus:outline-none focus:shadow-outline"
									id="comments"
									name="comments"></textarea>
							</div>
							<div class="mt-4 mb-2 sm:mb-4">
								<button
									type="submit"
									class="inline-flex items-center justify-center w-full h-12 px-6 font-medium tracking-wide text-white transition duration-200 rounded shadow-md hover:text-blue-accent-400 bg-blue-accent-400 hover:bg-white focus:shadow-outline focus:outline-none"
								>
									{ctaText}
								</button>
							</div>
							<p class="text-xs text-gray-600 sm:text-sm">
								{description}
							</p>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
