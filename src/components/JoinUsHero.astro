---
// Component import

import { Picture } from "@astrojs/image/components";
import JoinWithUsForm from "./JoinWithUsForm.astro";
export interface Props {
	title: string;
	subtitle: string;
	queratorText: string;
	body: string;
	description: string;
	ctaText: string;
}

const { title, subtitle, queratorText, body, description, ctaText } =
	Astro.props;
---

<div class="relative">
	<Picture
		src={"./src/asset/images/join-with-us-hero.png"}
		alt={"sponsorTertiary.title"}
		widths={[200, 400, 800]}
		sizes="(max-width: 800px) 100vw, 800px"
		aspectRatio="16:9"
		class={'absolute inset-0 object-cover w-full h-full'}
	/>
	<div class="relative bg-opacity-75 bg-blue-accent-700">
		<svg
			class="absolute inset-x-0 bottom-0 text-white"
			viewBox="0 0 1160 160"
		>
			<path
				fill="currentColor"
				d="M-164 13L-104 39.7C-44 66 76 120 196 141C316 162 436 152 556 119.7C676 88 796 34 916 13C1036 -8 1156 2 1216 7.7L1276 13V162.5H1216C1156 162.5 1036 162.5 916 162.5C796 162.5 676 162.5 556 162.5C436 162.5 316 162.5 196 162.5C76 162.5 -44 162.5 -104 162.5H-164V13Z"
			></path>
		</svg>
		<div
			class="relative px-4 py-16 mx-auto overflow-hidden sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20"
		>
			<div class="flex flex-col items-center justify-between xl:flex-row">
				<div class="w-full max-w-xl mb-12 xl:mb-0 xl:pr-16 xl:w-7/12">
					<h2
						class="max-w-lg mb-6 font-sans text-3xl font-bold tracking-tight text-white sm:text-4xl sm:leading-none"
					>
						{title}
					</h2>
					<p class="max-w-xl mb-4 text-base text-gray-200 md:text-lg">
						{body}
					</p>
					<p
						class="inline-block p-3 pl-5 pr-5 text-xs font-semibold tracking-wider text-white uppercase rounded-full bg-red-accent-400"
					>
						{queratorText}
					</p>
				</div>
				<div class="w-full max-w-xl xl:px-8 xl:w-5/12">
					<div class="bg-white rounded shadow-2xl p-7 sm:p-10">
						<h3
							class="mb-4 text-xl font-semibold sm:text-center sm:mb-6 sm:text-2xl"
						>
							{subtitle}
						</h3>
						<JoinWithUsForm
							firstName="First Name"
							lastName="Last Name"
							email="Email"
							mobile="Mobile"
							comments="Comments"
							description={description}
							ctaText={ctaText}
						/>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
