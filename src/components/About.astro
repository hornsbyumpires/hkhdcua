---
import { Picture } from "@astrojs/image/components";
import aboutImg from "../asset/images/about.png";
export interface Props {
	title: string;
	subtitle: string;
	body: string;
}

const { title, subtitle, body } = Astro.props as Props;
---

<div
	class="px-4 py-16 mx-auto sm:max-w-xl md:max-w-full lg:max-w-screen-xl md:px-24 lg:px-8 lg:py-20"
>
	<div class="grid gap-5 row-gap-8 lg:grid-cols-2">
		<div class="flex flex-col justify-center">
			<div class="max-w-xl mb-6">
				<p
					class="inline-block px-6 py-2 mb-4 text-xs font-semibold tracking-wider text-white uppercase rounded-full bg-blue-accent-400"
				>
					{subtitle}
				</p>
				<h2
					class="max-w-lg mb-6 font-sans text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl sm:leading-none"
				>
					{title}
				</h2>
				<p class="text-base text-gray-700 md:text-lg">
					{body}
				</p>
			</div>
		</div>
		<div class="object-cover w-full rounded">
			<Picture
				src={aboutImg}
				alt={title}
				widths={[200, 400, 800]}
				sizes="(max-width: 800px) 100vw, 800px"
				aspectRatio="16:9"
			/>
		</div>
	</div>
</div>
